{
  "name": "verdesakay-inventory-launcher",
  "version": "1.0.0",
  "description": "Verdesakay Inventory System desktop launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.verdesakay.inventory",
    "productName": "Verdesakay Inventory",
    "win": {
      "target": "portable",
      "artifactName": "Verdesakay-Inventory.exe",
      "sign": null,
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
