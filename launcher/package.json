{
  "name": "otom-launcher",
  "version": "1.0.0",
  "description": "Otom desktop launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.afkcube.otom",
    "productName": "Otom",
    "win": {
      "target": "portable",
      "artifactName": "Otom.exe",
      "sign": null,
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
