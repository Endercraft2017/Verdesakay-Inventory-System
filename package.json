{
  "name": "otom",
  "version": "1.0.0",
  "description": "Otom by AFKcube: office system: inventory, forms, accounts, messaging",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run",
    "tenant:create": "tsx scripts/tenant.ts create",
    "tenant:list": "tsx scripts/tenant.ts list",
    "tenant:status": "tsx scripts/tenant.ts status",
    "tenant:plan": "tsx scripts/tenant.ts plan",
    "tenant:modules": "tsx scripts/tenant.ts modules",
    "tenant:usage": "tsx scripts/tenant.ts usage",
    "tenant:purge": "tsx scripts/tenant.ts purge",
    "platform:user": "tsx scripts/platform-user.ts",
    "migrate:all": "tsx scripts/migrate-all.ts",
    "db:types": "tsx scripts/gen-db-types.ts",
    "backup": "tsx scripts/backup.ts now",
    "backup:list": "tsx scripts/backup.ts list",
    "backup:drill": "tsx scripts/backup.ts drill",
    "backup:health": "tsx scripts/backup.ts health",
    "backup:restore": "tsx scripts/backup.ts restore",
    "backup:offsite": "tsx scripts/offsite.ts",
    "sync:enrol": "tsx scripts/sync-enrol.ts",
    "desktop": "node scripts/desktop.mjs",
    "desktop:smoke": "node scripts/desktop.mjs --smoke",
    "desktop:cert": "powershell -ExecutionPolicy Bypass -File scripts/desktop-cert.ps1",
    "desktop:build": "electron-builder --win nsis",
    "test:node24": "node scripts/test-node24.mjs",
    "test:editor:ux": "node scripts/test-editor-ux.mjs",
    "test:forms:ux": "node scripts/test-forms-ux.mjs",
    "test:mobile:qr": "node scripts/test-mobile-qr-ux.mjs",
    "test:mobile:workflow": "node scripts/test-mobile-remaining-ux.mjs",
    "test:mobile:access": "node scripts/test-mobile-work-access.mjs",
    "test:inventory:ckd-courier": "node scripts/test-inventory-ckd-courier-ux.mjs",
    "test:forms:connected:ux": "node scripts/test-connected-forms-ux.mjs",
    "test:invoice:ux": "node scripts/test-invoice-ux.mjs"
  },
  "build": {
    "appId": "com.afkcube.otom.desktop",
    "productName": "Otom",
    "copyright": "AFKcube",
    "directories": { "output": "dist-desktop" },
    "asar": false,
    "extraMetadata": { "main": "electron/main.cjs" },
    "files": [
      "server.ts",
      "package.json",
      "src/**/*",
      "public/**/*",
      "electron/**/*",
      "scripts/sync-enrol.ts",
      "!**/*.test.ts"
    ],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "shortcutName": "Otom"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "docx": "^9.7.1",
    "domhandler": "^6.0.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "kysely": "^0.29.6",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.1.0",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
