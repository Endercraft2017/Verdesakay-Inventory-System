{
  "name": "verdesakay-office-system",
  "version": "1.0.0",
  "description": "Verdesakay local office system: inventory, forms, accounts, messaging",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run",
    "tenant:create": "tsx scripts/tenant.ts create",
    "tenant:list": "tsx scripts/tenant.ts list",
    "tenant:status": "tsx scripts/tenant.ts status",
    "tenant:plan": "tsx scripts/tenant.ts plan",
    "tenant:modules": "tsx scripts/tenant.ts modules",
    "tenant:usage": "tsx scripts/tenant.ts usage",
    "tenant:purge": "tsx scripts/tenant.ts purge",
    "platform:user": "tsx scripts/platform-user.ts",
    "migrate:all": "tsx scripts/migrate-all.ts",
    "db:types": "tsx scripts/gen-db-types.ts",
    "backup": "tsx scripts/backup.ts now",
    "backup:list": "tsx scripts/backup.ts list",
    "backup:restore": "tsx scripts/backup.ts restore",
    "backup:offsite": "tsx scripts/offsite.ts",
    "sync:enrol": "tsx scripts/sync-enrol.ts",
    "desktop": "node scripts/desktop.mjs",
    "desktop:smoke": "node scripts/desktop.mjs --smoke",
    "desktop:cert": "powershell -ExecutionPolicy Bypass -File scripts/desktop-cert.ps1",
    "desktop:build": "electron-builder --win nsis",
    "test:node24": "node scripts/test-node24.mjs",
    "test:e2e": "playwright test",
    "test:load": "node scripts/audit-load.mjs"
  },
  "build": {
    "appId": "com.verdesakay.desktop",
    "productName": "Verdesakay",
    "copyright": "Verdesakay",
    "directories": {
      "output": "dist-desktop"
    },
    "asar": false,
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "files": [
      "server.ts",
      "package.json",
      "src/**/*",
      "public/**/*",
      "electron/**/*",
      "scripts/sync-enrol.ts",
      "!**/*.test.ts"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "shortcutName": "Verdesakay"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "docx": "^9.7.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "kysely": "^0.29.6",
    "multer": "^2.2.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.1.1",
    "tsx": "^4.23.15",
    "undici": "^7.30.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
